# Frontend Environment Variables
# Copy to .env.local and fill in your values.
#
# NEXT_PUBLIC_* vars are inlined into the static export at BUILD time (this
# is a static Next.js export, not SSR) -- deploy-frontend.sh/.bat populate
# this file automatically from `terraform output` before building, so you
# normally don't need to edit this by hand except for local dev.

# API Gateway endpoint (set after Terraform deployment). Leave as the
# localhost default for local dev against local_api_server.py.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cognito (set after Terraform deployment -- see infra/cognito.tf outputs
# cognito_user_pool_id / cognito_spa_client_id). Leave BOTH blank for local
# dev: the app then skips the login screen entirely (see
# src/lib/auth.ts's AUTH_ENABLED) since local_api_server.py never checks a
# JWT anyway -- only the real API Gateway authorizer does once deployed.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
