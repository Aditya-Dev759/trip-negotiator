# Local Testing Configuration
ENVIRONMENT=local
DYNAMODB_TABLE=trip-negotiations-local
S3_BUCKET=trip-negotiator-data-local
GROQ_API_KEY=your-groq-key-for-testing

# Web search grounding uses the open-source `ddgs` library by default --
# no API key, no server, no config needed (just `pip install -r requirements.txt`).
#
# Optional: if you'd rather run your own self-hosted SearxNG instance instead
# (docker run -d -p 8080:8080 searxng/searxng, with `json` added under
# search.formats in settings.yml), set SEARX_HOST and it'll be used as a
# fallback if ddgs returns 0 results. Not required.
# SEARX_HOST=http://localhost:8080

# Optional: For remote testing with real AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
