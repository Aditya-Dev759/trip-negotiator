{
  "Comment": "TripNegotiator negotiation workflow",
  "StartAt": "ItineraryAgent",
  "States": {
    "ItineraryAgent": {
      "Type": "Task",
      "Resource": "${itinerary_arn}",
      "TimeoutSeconds": 90,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "BudgetAgent"
    },
    "BudgetAgent": {
      "Type": "Task",
      "Resource": "${budget_arn}",
      "TimeoutSeconds": 90,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "LogisticsAgent"
    },
    "LogisticsAgent": {
      "Type": "Task",
      "Resource": "${logistics_arn}",
      "TimeoutSeconds": 90,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "BookingAgent"
    },
    "BookingAgent": {
      "Type": "Task",
      "Resource": "${booking_arn}",
      "TimeoutSeconds": 90,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "CheckConvergence"
    },
    "CheckConvergence": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.allApproved",
          "BooleanEquals": true,
          "Next": "Finalize"
        },
        {
          "Variable": "$.round",
          "NumericGreaterThanEquals": 3,
          "Next": "ForceFinalize"
        }
      ],
      "Default": "ItineraryAgent"
    },
    "Finalize": {
      "Type": "Task",
      "Resource": "${supervisor_arn}",
      "TimeoutSeconds": 30,
      "End": true
    },
    "ForceFinalize": {
      "Type": "Task",
      "Resource": "${supervisor_arn}",
      "TimeoutSeconds": 30,
      "End": true
    },
    "HandleError": {
      "Type": "Pass",
      "Result": {
        "error": "Workflow failed",
        "status": "failed"
      },
      "End": true
    }
  }
}
